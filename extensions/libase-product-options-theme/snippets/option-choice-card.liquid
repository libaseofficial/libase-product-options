{%- comment -%}
  画像付き選択肢カード1枚を描画する。dropdown(radio)/checkbox(checkbox)で共用する。
  必須パラメータ: choice, input_type("radio"|"checkbox"), input_name, field_id
  任意パラメータ: required(radioの場合のみ有効)
{%- endcomment -%}

{%- liquid
  assign card_input_id = 'libase-choice-' | append: field_id | append: '-' | append: choice.id
  # checkboxは既存の非カード版と同じくlabelを送信値として使う(dropdownはvalueを使う)。
  if input_type == 'checkbox'
    assign card_input_value = choice.label
  else
    assign card_input_value = choice.value
  endif
-%}

<label class="libase-options__card" for="{{ card_input_id }}">
  <input
    type="{{ input_type }}"
    id="{{ card_input_id }}"
    name="{{ input_name }}"
    value="{{ card_input_value }}"
    class="libase-options__card-input"
    {% if input_type == 'radio' %}data-libase-input{% endif %}
    {% if input_type == 'checkbox' %}data-libase-checkbox-input{% endif %}
    {% if required and input_type == 'radio' %}required{% endif %}
    {% if choice.linkedVariantId != blank %}data-libase-variant-id="{{ choice.linkedVariantId }}"{% endif %}
    data-libase-price-adjustment="{{ choice.priceAdjustment | default: 0 }}"
    data-libase-option-key="{{ choice.label }}"
  >
  <span class="libase-options__card-body">
    {%- if choice.imageUrl != blank -%}
      <span class="libase-options__card-image-wrap">
        <img
          class="libase-options__card-image"
          src="{{ choice.imageUrl }}"
          alt="{{ choice.label }}"
          loading="lazy"
          width="200"
          height="200"
          onerror="this.parentElement.style.display='none'"
        >
      </span>
    {%- endif -%}
    <span class="libase-options__card-label">{{ choice.label }}</span>
    {%- if choice.priceAdjustment and choice.priceAdjustment > 0 -%}
      <span class="libase-options__card-price">+¥{{ choice.priceAdjustment }}</span>
    {%- endif -%}
  </span>
  <span class="libase-options__card-check" aria-hidden="true"></span>
</label>
