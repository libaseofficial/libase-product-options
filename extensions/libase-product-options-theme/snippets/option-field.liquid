{%- comment -%}
  1つの商品オプション項目を描画するスニペット。
  対応タイプ: text-box / dropdown / checkbox
  未対応タイプ(product-list / file-upload)はメタフィールド同期の時点で除外されるため、
  ここには渡ってこない想定。
{%- endcomment -%}

{%- liquid
  assign libase_field_id = 'libase-field-' | append: block_id | append: '-' | append: field.id
-%}

<div
  class="libase-options__field libase-options__field--{{ field.type }}"
  data-libase-field
  data-libase-type="{{ field.type }}"
  data-libase-label="{{ field.label }}"
  data-libase-required="{{ field.required }}"
>
  <label class="libase-options__label" for="{{ libase_field_id }}">
    {{ field.label }}
    {%- if field.required %}<span class="libase-options__required" aria-hidden="true">*</span>{% endif -%}
  </label>

  {%- case field.type -%}
    {%- when 'text-box' -%}
      <input
        type="text"
        id="{{ libase_field_id }}"
        class="libase-options__input"
        data-libase-input
        {% if field.placeholder != blank %}placeholder="{{ field.placeholder }}"{% endif %}
        {% if field.maxLength %}maxlength="{{ field.maxLength }}"{% endif %}
        {% if field.required %}required{% endif %}
      >

    {%- when 'dropdown' -%}
      {%- liquid
        assign has_choice_images = false
        for choice in field.choices
          if choice.imageUrl != blank
            assign has_choice_images = true
          endif
        endfor
      -%}
      {%- if has_choice_images -%}
        <div class="libase-options__card-grid" role="radiogroup" aria-label="{{ field.label }}">
          {%- for choice in field.choices -%}
            {%- render 'option-choice-card',
              choice: choice,
              input_type: 'radio',
              input_name: libase_field_id,
              field_id: libase_field_id,
              required: field.required
            -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <select
          id="{{ libase_field_id }}"
          class="libase-options__select"
          data-libase-input
          {% if field.required %}required{% endif %}
        >
          <option value="">選択してください</option>
          {%- for choice in field.choices -%}
            <option
              value="{{ choice.value }}"
              {% if choice.linkedVariantId != blank %}data-libase-variant-id="{{ choice.linkedVariantId }}"{% endif %}
              data-libase-price-adjustment="{{ choice.priceAdjustment | default: 0 }}"
              data-libase-option-key="{{ choice.label }}"
            >{{ choice.label }}</option>
          {%- endfor -%}
        </select>
      {%- endif -%}

    {%- when 'checkbox' -%}
      {%- liquid
        assign has_choice_images = false
        for choice in field.choices
          if choice.imageUrl != blank
            assign has_choice_images = true
          endif
        endfor
      -%}
      {%- if has_choice_images -%}
        <div class="libase-options__card-grid" role="group" aria-label="{{ field.label }}">
          {%- for choice in field.choices -%}
            {%- render 'option-choice-card',
              choice: choice,
              input_type: 'checkbox',
              input_name: libase_field_id,
              field_id: libase_field_id
            -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="libase-options__checkbox-group">
          {%- for choice in field.choices -%}
            <label class="libase-options__checkbox-option">
              <input
                type="checkbox"
                name="{{ libase_field_id }}"
                value="{{ choice.label }}"
                data-libase-checkbox-input
                {% if choice.linkedVariantId != blank %}data-libase-variant-id="{{ choice.linkedVariantId }}"{% endif %}
                data-libase-price-adjustment="{{ choice.priceAdjustment | default: 0 }}"
                data-libase-option-key="{{ choice.label }}"
              >
              {{ choice.label }}
            </label>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if field.required -%}
        {%- comment -%}
          チェックボックス群には native required を直接付けられないため、
          「1つ以上選択済みか」をJSで同期する非表示の代理input(name属性なし)で
          ブラウザ標準のフォームバリデーションを効かせる。display:noneにすると
          バリデーション対象から外れてしまうため、視覚的に隠すだけに留める。
        {%- endcomment -%}
        <input
          type="checkbox"
          class="libase-options__checkbox-required-proxy"
          data-libase-checkbox-required-proxy
          aria-hidden="true"
          tabindex="-1"
          required
        >
      {%- endif -%}
  {%- endcase -%}

  {%- if field.helpText != blank -%}
    <p class="libase-options__help">{{ field.helpText }}</p>
  {%- endif -%}
</div>
